# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

PORT=8000

# Local MongoDB instance
MONGODB_URI=mongodb://127.0.0.1:27017/hirehub

# Generate any long random string for this (used to sign JWTs)
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Optional: your Google Gemini API key (aistudio.google.com/app/apikey).
# Used for AI resume parsing and the chatbot. Without it, resumes are parsed
# by the built-in rule-based parser and the chatbot returns a fallback reply.
GEMINI_API_KEY=your_gemini_api_key_here

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173
